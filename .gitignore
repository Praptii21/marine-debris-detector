# Backend — model weights and generated annotation data are not source
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
# Model weights are tracked for cloud deployment (all files < 50MB)
# Exclude the heavy medium variant (yolo26m) to prevent OOM on 512MB RAM cloud tiers
backend/models/**/yolo26m.pt
backend/annotations/images/*
!backend/annotations/images/.gitkeep
backend/annotations/labels/*
!backend/annotations/labels/.gitkeep
backend/annotations/rejected.jsonl
backend/app.py
